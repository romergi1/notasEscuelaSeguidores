# Copia este archivo a ".env" (en la misma carpeta que docker-compose.yml) y ajusta los valores.

# Contraseña para acceder al panel de administración (/admin). Obligatoria.
ADMIN_PASSWORD=cambia-esta-clave

# Clave para firmar las sesiones de administrador. Opcional: si la dejas vacía,
# el backend genera una al arrancar (las sesiones se cierran al reiniciar el contenedor).
JWT_SECRET=
